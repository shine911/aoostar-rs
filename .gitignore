# hwbridge: track source, build script, config, and notices; exclude build output
# (HwBridge.exe) and the NuGet dependencies build.ps1 fetches (lib/, packages/)
/hwbridge/*
!/hwbridge/*.cs
!/hwbridge/build.ps1
!/hwbridge/HwBridge.exe.config
!/hwbridge/NOTICE.md
!/hwbridge/licenses/

# private sensor value files
/cfg/sensors/sysinfo.txt
/cfg/sensors/hwbridge.txt
